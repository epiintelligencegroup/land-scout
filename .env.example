ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
RESEND_FROM="Land Scout <onboarding@resend.dev>"
DIGEST_TO=you@example.com

# Every run covers all 4 markets in markets.py and sends ONE combined
# digest email. Leave a market's CSV vars blank to run it on generated mock
# data shaped like a real export -- point them at a real export once you
# have one, no code changes needed.

# Austin, TX (Travis County)
LAND_CSV_PATH_TRAVIS_TX=
PERMITS_CSV_PATH_TRAVIS_TX=

# San Antonio, TX (Bexar County)
LAND_CSV_PATH_BEXAR_TX=
PERMITS_CSV_PATH_BEXAR_TX=

# Atlanta Suburbs, GA (Gwinnett County)
LAND_CSV_PATH_GWINNETT_GA=
PERMITS_CSV_PATH_GWINNETT_GA=

# Nashville Suburbs, TN (Williamson County)
LAND_CSV_PATH_WILLIAMSON_TN=
PERMITS_CSV_PATH_WILLIAMSON_TN=

# Below this many matched deals in a single run, a market triggers the
# low-inventory alert + new-market suggestions in the digest email.
LOW_INVENTORY_THRESHOLD=3

# Append-only log of every property ever sent, so it's never sent twice.
# Defaults to sent_properties.log in the project directory (gitignored).
SENT_LOG_PATH=
