ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
RESEND_FROM="Land Scout <onboarding@resend.dev>"
DIGEST_TO=you@example.com

# Skip tracing (BatchData) -- get your Bearer token from app.batchdata.com/settings
# Phone leads (owners 3-9 years) are skip traced automatically each run.
# Leave blank to skip the BatchData step (leads still show in digest as Phone Lead, no contact info).
BATCHDATA_API_KEY=

# Your contact info for generated direct mail letters (Mail Lead tier, 10+ years).
# These appear in the letter's closing. Set both before running so letters are print-ready.
WHOLESALER_PHONE=
WHOLESALER_EMAIL=

# Every run covers all 10 markets in markets.py and sends ONE combined
# digest email. Leave a market's CSV vars blank to run it on generated mock
# data shaped like a real export -- point them at a real export once you
# have one, no code changes needed.

# Austin, TX (Travis County)
LAND_CSV_PATH_TRAVIS_TX=
PERMITS_CSV_PATH_TRAVIS_TX=

# San Antonio, TX (Bexar County)
LAND_CSV_PATH_BEXAR_TX=
PERMITS_CSV_PATH_BEXAR_TX=

# Atlanta Suburbs, GA (Gwinnett County)
LAND_CSV_PATH_GWINNETT_GA=
PERMITS_CSV_PATH_GWINNETT_GA=

# Nashville Suburbs, TN (Williamson County)
LAND_CSV_PATH_WILLIAMSON_TN=
PERMITS_CSV_PATH_WILLIAMSON_TN=

# Medina County, TX (Natalia area) -- skip_builder_matching=True, no permits
# var applies (you have a direct buyer here, see markets.py/README)
LAND_CSV_PATH_MEDINA_TX=

# Atascosa County, TX (Poteet area) -- same as Medina above
LAND_CSV_PATH_ATASCOSA_TX=

# Charlotte, NC (Mecklenburg County)
LAND_CSV_PATH_MECKLENBURG_NC=
PERMITS_CSV_PATH_MECKLENBURG_NC=

# Phoenix Metro, AZ (Mesa/Maricopa County) -- scoped to Mesa, see README
LAND_CSV_PATH_MARICOPA_AZ=
PERMITS_CSV_PATH_MARICOPA_AZ=

# Nashville, TN (Davidson County)
LAND_CSV_PATH_DAVIDSON_TN=
PERMITS_CSV_PATH_DAVIDSON_TN=

# Raleigh, NC (Wake County) -- scoped to Raleigh, see README
LAND_CSV_PATH_WAKE_NC=
PERMITS_CSV_PATH_WAKE_NC=

# Below this many matched deals in a single run, a market triggers the
# low-inventory alert + new-market suggestions in the digest email.
LOW_INVENTORY_THRESHOLD=3

# Append-only log of every property ever sent, so it's never sent twice.
# Defaults to sent_properties.log in the project directory (git-tracked, not
# gitignored -- the cloud routine needs it committed to carry forward).
SENT_LOG_PATH=
