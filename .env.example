ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
RESEND_FROM="House Wholesale <onboarding@resend.dev>"
DIGEST_TO=you@example.com

# Optional: point at real county assessor CSV exports.
# Each market has its own var. Leave blank to run on generated mock data.
# Column names expected: apn, property_address, city, state, zip_code,
#   owner_name, owner_mailing_address, owner_mailing_city, owner_mailing_state,
#   owner_mailing_zip, year_built, assessed_value, improvement_value,
#   years_owned, last_sale_date, last_sale_price, property_class,
#   tax_delinquent (YES/NO), in_foreclosure (YES/NO), bank_owned (YES/NO)

# Baltimore, MD (Baltimore City)
HOUSE_CSV_PATH_BALTIMORE_MD=

# St. Louis, MO (St. Louis City)
HOUSE_CSV_PATH_STLOUIS_MO=

# Kansas City, MO (Jackson County)
HOUSE_CSV_PATH_KANSASCITY_MO=

# Philadelphia, PA (Philadelphia County)
HOUSE_CSV_PATH_PHILADELPHIA_PA=

# Cincinnati, OH (Hamilton County)
HOUSE_CSV_PATH_CINCINNATI_OH=

# Number of leads to pull per market in a live or mock run.
# Raise deliberately — don't let a live source silently pull hundreds.
MOCK_LEAD_COUNT=10

# Append-only dedup log. Defaults to sent_properties.log (git-tracked).
# The cloud routine commits it back after each successful send so the log
# carries forward across daily runs without a database.
SENT_LOG_PATH=
